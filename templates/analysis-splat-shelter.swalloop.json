{
  "format": "swalloop-graph",
  "version": 1,
  "name": "Gaussian splats: shelter map",
  "description": "Every neighbouring building becomes a 2D Gaussian splat. Added up they are a density map of where the block is tall (shelter and shade); composited front to back by height they are the splat render of the block, the same blending rule as 3D Gaussian splatting.",
  "group": "Analysis and vision",
  "nodes": [
