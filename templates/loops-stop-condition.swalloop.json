{
  "format": "swalloop-graph",
  "version": 1,
  "name": "Demo: stop condition (Newton until close)",
  "description": "Stops when a Condition built from Math and Compare becomes true, read from the current state.",
  "group": "Loop basics",
  "nodes": [
    {
      "id": "x0",
      "type": "number",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "value": 1,
        "min": 0.1,
        "max": 10
      }
    },
    {
      "id": "a",
      "type": "number",
      "position": {
        "x": 0,
        "y": 190
      },
      "params": {
        "value": 2,
        "min": 0.5,
        "max": 50
      }
    },
    {
      "id": "start",
      "type": "loopStart",
      "position": {
        "x": 280,
        "y": 0
      },
      "params": {}
    },
    {
      "id": "step",
      "type": "newton",
      "position": {
        "x": 520,
        "y": 0
      },
      "params": {
        "a": 2
      }
    },
    {
      "id": "sq",
      "type": "math",
      "position": {
        "x": 520,
        "y": 190
      },
      "params": {
        "op": "×",
        "a": 0,
        "b": 0
      }
    },
    {
      "id": "err",
      "type": "math",
      "position": {
        "x": 780,
        "y": 190
      },
      "params": {
        "op": "|a-b|",
        "a": 0,
        "b": 0
      }
    },
    {
      "id": "close",
      "type": "compare",
      "position": {
        "x": 1040,
        "y": 190
      },
      "params": {
        "op": "<",
        "a": 0,
        "b": 1e-9
      }
    },
    {
      "id": "end",
      "type": "loopEnd",
      "position": {
        "x": 1040,
        "y": 0
      },
      "params": {
        "kind": "Repeat",
        "iterations": 50,
        "tolerance": 0
      }
    },
    {
      "id": "view",
      "type": "inspect",
      "position": {
        "x": 1320,
        "y": 0
      },
      "params": {}
    },
    {
      "id": "count",
      "type": "readout",
      "position": {
        "x": 1320,
        "y": 190
      },
      "params": {}
    }
  ],
  "edges": [
    {
      "from": "x0.value",
      "to": "start.initial"
    },
    {
      "from": "a.value",
      "to": "step.a"
    },
    {
      "from": "start.state",
      "to": "step.x"
    },
    {
      "from": "step.x",
      "to": "end.result"
    },
    {
      "from": "start.state",
      "to": "sq.a"
    },
    {
      "from": "start.state",
      "to": "sq.b"
    },
    {
      "from": "sq.result",
      "to": "err.a"
    },
    {
      "from": "a.value",
      "to": "err.b"
    },
    {
      "from": "err.result",
      "to": "close.a"
    },
    {
      "from": "close.result",
      "to": "end.condition"
    },
    {
      "from": "end.result",
      "to": "view.value"
    },
    {
      "from": "end.history",
      "to": "view.history"
    },
    {
      "from": "end.count",
      "to": "count.value"
    }
  ]
}
